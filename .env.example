# Backend API URL
# Mode Symfony natif : http://<IP_LAN_PC>:8000/api
# Mode backend web via Docker Compose : http://<IP_LAN_PC>/api
# Le front essaie maintenant de resoudre automatiquement la bonne URL locale,
# mais definir explicitement EXPO_PUBLIC_API_URL reste le plus fiable sur mobile.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Autres configs si necessaire
EXPO_PUBLIC_ENV=development
